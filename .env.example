# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# ── Paiement Premium (Lemon Squeezy) ─────────────────────────────────
# Ces variables se posent côté DÉPLOIEMENT Convex (`npx convex env set`),
# jamais dans .env.local. Vides = paiement désactivé proprement : la
# boutique affiche « bientôt disponible » et ne promet aucune caisse.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_TEST_MODE=
APP_URL=
