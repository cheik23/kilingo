# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# ── Paiement Premium (Lemon Squeezy) ─────────────────────────────────
# À poser côté DÉPLOIEMENT Convex (`npx convex env set NOM valeur`), jamais
# dans .env.local : ces valeurs sont lues par les fonctions serveur
# (src/convex/lemonsqueezy.ts) et ne partent jamais au client.
#
# Toutes vides = paiement désactivé PROPREMENT, sans crash : le bouton
# Premium affiche « bientôt disponible » et ne promet aucune caisse.
#
# Clé API du compte (Dashboard → Settings → API). C'est elle qui ouvre le
# module : sans clé, `paymentsConfigured()` est faux et rien ne s'active.
LEMONSQUEEZY_API_KEY=
# Secret de signature des webhooks (Settings → Webhooks). Sans lui, la
# route de webhook REFUSE l'événement au lieu de le croire sur parole.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant de l'abonnement (celui qui porte le prix encaissé). Laissé vide,
# l'app le découvre via l'API ; les montants AFFICHÉS viennent de
# src/lib/pricing.ts, jamais d'ici.
LEMONSQUEEZY_VARIANT_ID=
# Boutique visée, pour la caisse et le portail client. Vide = découverte.
LEMONSQUEEZY_STORE_ID=
# « true », « 1 » ou « yes » = bac à sable ; toute autre valeur (ou vide)
# = mode réel.
LEMONSQUEEZY_TEST_MODE=
# Origine de repli des URLs de retour (après paiement, portail). L'origine
# du navigateur a la priorité ; celle-ci n'est qu'un filet.
APP_URL=
